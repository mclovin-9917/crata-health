# Copy to .env (never commit .env).
# perceive = audio and images (Nano Omni, only on NVIDIA build).
# reason = extraction and cross-checks: nvidia day to day, nebius for the final eval and demo.
PERCEIVE_PROVIDER=nvidia
REASON_PROVIDER=nvidia
NVIDIA_API_KEY=
NEBIUS_API_KEY=
# Tavily: medicine summaries from trusted sites (without it, tapping a medicine says it is not set up).
TAVILY_API_KEY=
# Sign-in: no SMS provider yet, so codes are shown on screen. Demo accounts for hackathon judges:
# SMS_PROVIDER=simulated
# DEMO_LOGINS=true
# Optional overrides if a model ID differs from the profile in app/config.py:
# MODEL_PERCEIVE=
# MODEL_REASON=
# REQUEST_TIMEOUT_S=90
# REQUEST_MAX_RETRIES=3
# Read document photos with thinking on by default (slow; the Review screen can ask for it per visit):
# DOCUMENT_THINKING=false
# Backup when the primary hangs or is busy (needs both keys). Audio has no backup.
# FALLBACK=true
# MODEL_PERCEIVE_FALLBACK=google/gemma-3-27b-it
# FALLBACK_TIMEOUT_S=45
# Medicine summaries are kept this many days per medicine:
# MEDICINE_INFO_DAYS=30
# TAVILY_TIMEOUT_S=20
